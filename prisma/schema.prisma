// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Modelo de Usuario con Roles definidos
model Usuario {
  id        String     @id @default(cuid())
  nombre    String
  email     String     @unique
  rol       String     // Roles: GERENTE_GENERAL, GERENTE_TECNICA, DIRECTOR, INTERVENTOR, CONTADOR, ADMIN
  avatar    String?    // Iniciales para el UI
  
  // Relaciones
  proyectosDirigidos Proyecto[] @relation("DirectorProyecto")
  proyectosAsignados Proyecto[] @relation("InterventoresAsignados") // Relación M-N explícita
  
  createdAt DateTime   @default(now())
}

model Proyecto {
  id          String   @id @default(cuid())
  nombre      String
  cliente     String
  centroCosto String   @unique
  presupuesto Float    // Presupuesto Contractual
  ejecutado   Float    @default(0) // Sumatoria de facturas aprobadas
  fechaInicio DateTime
  estado      String   @default("ACTIVO") // Estados: ACTIVO, SUSPENDIDO, FINALIZADO
  
  // Relaciones
  directorId  String
  director    Usuario  @relation("DirectorProyecto", fields: [directorId], references: [id])
  
  // Un proyecto puede tener múltiples interventores
  interventores Usuario[] @relation("InterventoresAsignados")
  
  eventos     Evento[]
  createdAt   DateTime @default(now())
}

model Evento {
  id            String   @id @default(cuid())
  tipo          String   // Tipos: ACTA_INICIO, PRORROGA, SUSPENSION, ADICION, FACTURACION, INFORME_TECNICO
  fecha         DateTime
  descripcion   String
  
  // Campos exclusivos para lógica de negocio avanzada
  valor         Float?   // Para Facturación o Adiciones
  numeroFactura String?  // Obligatorio para Contadores (CU-03)
  soporteUrl    String?  // Ruta al archivo PDF almacenado
  
  // Relaciones
  proyectoId    String
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id])
  
  createdAt     DateTime @default(now())
}